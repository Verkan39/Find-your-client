# AI, business-data and web-search keys are NOT configured here: each user adds
# their own on the Profile page, and they're stored encrypted in Supabase.

# Contact used in the User-Agent for OpenStreetMap (Nominatim/Overpass) - their usage policy requires one.
OSM_CONTACT_EMAIL=

# How many businesses are analysed in parallel (crawl + AI). Keep low to respect rate limits.
ANALYSIS_CONCURRENCY=3

# --- Supabase (required) ---
# Hosted: Project Settings → API Keys. Local: run `npx supabase start`, then `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) — safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — server only. Lets the analysis worker write results. Never expose it.
SUPABASE_SECRET_KEY=

# Max businesses one user can request per 24h (protects your API credits).
DAILY_BUSINESS_LIMIT=150

# Encrypts users' saved API keys (AES-256-GCM). Required. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later makes every saved key unreadable (users would re-enter them).
KEYS_ENCRYPTION_SECRET=
