# Optional but strongly recommended: turns on deep AI research + pitch generation.
# Without it the app still discovers, crawls and scores businesses with its built-in heuristic engine.
ANTHROPIC_API_KEY=

# Optional: enriches businesses with Google ratings, review counts, price level and opening hours.
# Uses the Places API (New) - https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=

# Contact used in the User-Agent for OpenStreetMap (Nominatim/Overpass) - their usage policy requires one.
OSM_CONTACT_EMAIL=

# How many businesses are analysed in parallel (crawl + AI). Keep low to respect rate limits.
ANALYSIS_CONCURRENCY=3
